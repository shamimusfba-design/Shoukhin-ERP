# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3001)
PORT=3001

# STEADFAST COURIER API (Packzy API v1)
# Leave blank to use in-app Settings, or enter "mock" to force mock mode
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_TOKEN=""
MOCK_COURIER="false"

# META GRAPH API (Ads insights)
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="1430584315368882"
MOCK_META="false"
